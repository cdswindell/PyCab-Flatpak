#!/bin/sh
export PYTRAIN_PLATFORM=steamdeck
export PYTRAIN_DISABLE_SELF_UPDATE=1
export PYTHONUNBUFFERED=1
unset LD_PRELOAD

# Keep synchronized engine images, product metadata, and configuration
# on persistent Flatpak storage, shared by client and server modes.
CACHE_ROOT="${XDG_DATA_HOME:-$HOME/.var/app/io.github.cdswindell.PyCab/data}/cache"
mkdir -p "$CACHE_ROOT/engine_images" "$CACHE_ROOT/engine_info" "$CACHE_ROOT/config" || exit 1
export PYTRAIN_CACHE_DIR="$CACHE_ROOT"

# No -base: PyTrain client. -base [IP]: Base 3 server mode.
case "${1:-}" in
  -base)
    shift
    case "${1:-}" in
      ""|-*)
        exec /app/bin/pytrain -headless -base -buttons /app/share/pycab/buttons.py "$@"
        ;;
      *)
        BASE_IP="$1"
        shift
        exec /app/bin/pytrain -headless -base "$BASE_IP" -buttons /app/share/pycab/buttons.py "$@"
        ;;
    esac
    ;;
  *)
    exec /app/bin/pytrain -headless -client -buttons /app/share/pycab/buttons.py "$@"
    ;;
esac
