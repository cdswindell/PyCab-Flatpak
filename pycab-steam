#!/bin/sh
# Host-side launcher for Steam Gaming Mode. Only exit code 42 requests a relaunch.
# All other exits (including crashes and Quit) return control to Steam.
APP_ID=io.github.cdswindell.PyCab
while :; do
  /usr/bin/flatpak run "$APP_ID" "$@"
  status=$?
  if [ "$status" -ne 42 ]; then
    exit "$status"
  fi
  # Prevent an immediate restart loop if startup repeatedly requests a restart.
  sleep 1
done
