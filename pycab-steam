#!/usr/bin/env bash
# Steam Gaming Mode launcher. Exit 42 requests a relaunch; an update marker
# requests a verified host-side Flatpak replacement before that relaunch.
set -uo pipefail
# Steam injects a 32-bit overlay into 64-bit host utilities, generating harmless
# loader warnings. Keep Steam Input intact; clear only the incompatible preload.
if [[ "${LD_PRELOAD:-}" == *gameoverlayrenderer.so* ]]; then
  unset LD_PRELOAD
fi
APP_ID=io.github.cdswindell.PyCab
REQUEST="$HOME/.var/app/$APP_ID/data/pycab-update-request"
LOG_DIR="$HOME/.var/app/$APP_ID/data/runtime"
UPDATE_LOG="$LOG_DIR/pycab-update.log"
mkdir -p "$LOG_DIR"

update_pycab() (
  set -euo pipefail
  local tmp bundle_url checksum_url
  tmp="$(mktemp -d)" || return 1
  trap 'rm -rf "$tmp"' EXIT
  echo "Checking latest published PyCab release..."
  curl --fail --silent --show-error --location --retry 3 \
    -H 'Accept: application/vnd.github+json' \
    'https://api.github.com/repos/cdswindell/PyCab-Flatpak/releases/latest' \
    -o "$tmp/release.json" || return 1
  local installed_tag
  installed_tag="$(flatpak run --command=cat "$APP_ID" /app/share/pycab/release-tag)" || {
    echo "ERROR: Unable to read installed PyCab version; refusing replacement." >&2
    return 1
  }
  python3 - "$tmp/release.json" "$tmp/urls" "$installed_tag" <<'PY'
import json
import re
import sys
from pathlib import Path

release = json.loads(Path(sys.argv[1]).read_text())
tag = release["tag_name"]
if release.get("draft") or release.get("prerelease") or not re.fullmatch(r"v?\d+\.\d+\.\d+(?:-\d+)?", tag):
    sys.exit("ERROR: No valid stable PyCab release")
def version_key(value):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)(?:-(\d+))?(?:-dev\.(\d+))?", value)
    if match is None:
        sys.exit(f"ERROR: Invalid installed or available PyCab tag: {value}")
    major, minor, patch, revision, development = match.groups()
    return (int(major), int(minor), int(patch), int(revision or 0), int(development or 0))

installed_tag = sys.argv[3].strip()
if version_key(tag) <= version_key(installed_tag):
    print(f"No newer production release: installed {installed_tag}, latest {tag}. Keeping existing Flatpak.")
    Path(sys.argv[2]).write_text("SKIP\n")
    sys.exit(0)
assets = {asset["name"]: asset["browser_download_url"] for asset in release.get("assets", [])}
names = ("PyCab.flatpak", "PyCab.flatpak.sha256")
if not all(name in assets for name in names):
    sys.exit("ERROR: PyCab release is missing its bundle or checksum")
if not all(assets[name].startswith("https://github.com/cdswindell/PyCab-Flatpak/releases/download/") for name in names):
    sys.exit("ERROR: Unexpected release asset URL")
Path(sys.argv[2]).write_text("\n".join(assets[name] for name in names) + "\n")
print(f"Installing PyCab release {tag}...")
PY
  local rc=$?
  if (( rc != 0 )); then echo "ERROR: Release metadata validation failed ($rc)." >&2; return 1; fi
  [[ -s "$tmp/urls" ]] || { echo "ERROR: Missing release asset URLs." >&2; return 1; }
  if [[ "$(head -n 1 "$tmp/urls")" == "SKIP" ]]; then
    return 0
  fi
  bundle_url="$(sed -n '1p' "$tmp/urls")"
  checksum_url="$(sed -n '2p' "$tmp/urls")"
  [[ -n "$bundle_url" && -n "$checksum_url" ]] || { echo "ERROR: Empty asset URL." >&2; return 1; }
  curl --fail --silent --show-error --location --retry 3 -o "$tmp/PyCab.flatpak" "$bundle_url" || return 1
  curl --fail --silent --show-error --location --retry 3 -o "$tmp/PyCab.flatpak.sha256" "$checksum_url" || return 1
  python3 - "$tmp/PyCab.flatpak.sha256" "$tmp/PyCab.flatpak.check" <<'PY'
import re
import sys
from pathlib import Path

line = Path(sys.argv[1]).read_text().strip()
match = re.fullmatch(r"([0-9a-fA-F]{64})\s+\*?(.+)", line)
if not match or Path(match.group(2)).name != "PyCab.flatpak":
    sys.exit("ERROR: Invalid PyCab checksum")
Path(sys.argv[2]).write_text(f"{match.group(1)}  PyCab.flatpak\n")
PY
  rc=$?
  if (( rc != 0 )); then echo "ERROR: Invalid checksum metadata ($rc)." >&2; return 1; fi
  (cd "$tmp" && sha256sum -c PyCab.flatpak.check) || return 1
  flatpak install --user --reinstall -y "$tmp/PyCab.flatpak" || return 1
  echo "Installed release metadata:"
  flatpak run --command=cat "$APP_ID" /app/share/pycab/build-info || return 1
  echo "Synchronizing Steam host launcher..."
  local launcher_tmp
  mkdir -p "$HOME/.local/bin"
  launcher_tmp="$(mktemp "$HOME/.local/bin/.pycab-steam.XXXXXXXX")"
  if ! flatpak run --command=cat "$APP_ID" /app/share/pycab/pycab-steam > "$launcher_tmp" || [[ ! -s "$launcher_tmp" ]]; then
    rm -f "$launcher_tmp"
    echo "WARNING: Installed Flatpak has no bundled host launcher; keeping existing launcher." >&2
  else
    bash -n "$launcher_tmp" || { rm -f "$launcher_tmp"; echo "ERROR: Bundled launcher has invalid Bash syntax." >&2; return 1; }
    chmod 755 "$launcher_tmp" || return 1
    mv -f "$launcher_tmp" "$HOME/.local/bin/pycab-steam" || return 1
    echo "Host launcher synchronized."
  fi
  return 0
)

while :; do
  /usr/bin/flatpak run "$APP_ID" "$@"
  status=$?
  if [ "$status" -ne 42 ]; then
    # A normal Quit must never leave a pending update for a later session.
    rm -f "$REQUEST"
    exit "$status"
  fi
  if [ -f "$REQUEST" ]; then
    rm -f "$REQUEST"
    echo "[$(date -Is)] PyCab update requested; recording details in $UPDATE_LOG" | tee -a "$UPDATE_LOG"
    if update_pycab > >(tee -a "$UPDATE_LOG") 2> >(tee -a "$UPDATE_LOG" >&2); then
      echo "[$(date -Is)] Update succeeded; relaunching." | tee -a "$UPDATE_LOG"
    else
      echo "[$(date -Is)] ERROR: PyCab update failed; relaunching the existing installation." | tee -a "$UPDATE_LOG" >&2
    fi
  fi
  # Give a restarting server time to come back, and stagger clients so
  # they do not all reconnect simultaneously. Server mode must relaunch promptly.
  if [ "${1:-}" = "-base" ]; then
    sleep 1
  else
    delay=$((8 + RANDOM % 5))
    echo "Waiting ${delay}s before reconnecting PyCab client..."
    sleep "$delay"
  fi
done
